# Disc images, BIOS, and anything extracted from the disc never enter the repo.
# The source ISO lives outside the checkout (see docs/decisions.md, D-001).
*.iso
*.ISO
*.bin
*.BIN
*.cue
*.img
*.mdf
*.mds
*.nrg
*.chd
*.cso
*.zso
*.elf
*.ELF
*.irx
*.IRX
SLPS_*
SLPM_*
SCPS_*

# PS2 BIOS dumps and their companion files.
*.EROM
*.ROM0
*.ROM1
*.ROM2
*.NVM
*.MEC
*.erom
*.nvm
*.mec

# Working copies, extracted original text, QA captures.
/build/
/text/
/qa/

# Defensive: the private dir if someone points it inside the repo.
kimikiss-private/

# Python bytecode.
__pycache__/
