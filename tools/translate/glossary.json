 "policy": {
  "D1_name_order": {
   "decide": true,
   "recommended": "family-given (Japanese order): 'Sakino Asuka'",
   "options": [
    "family-given",
    "given-family (Western, as the anime subtitles and Wikipedia do)"
   ],
   "applies_to": "full names in prose, credits, name plates in textures (labels.tsv already family-given). Spoken address is almost always surname+honorific or given name alone, so order rarely shows."
  },
  "D2_romanization": {
   "decide": true,
   "recommended": "Hepburn, ASCII only (the font has no macrons). Write the kana: おう/おお -> ou/oo, うう -> uu, えい -> ei. Gives Shijou, Yuumi, Kuryuu, Kouichi (= the anime subtitles/MAL spelling). Names that are not long: Mao, Eriko, Narumi, Asuka.",
   "options": [
    "drop long vowels (Shijo, Yumi, Kuryu, Koichi; matches D-016 default 'Koichi')",
    "macrons (Shijo with macron etc.; needs new glyphs in font rows 11-12)"
   ],
   "label_changes": {
    "233": "Shijou Mitsuki (was Gijo Mizuki, wrong reading)",
    "72": "Kuryuu Megumu (was Kuriu Megumi)",
    "539": "Hoshino Yuumi (was Hoshino Yumi)"
   },
   "default_player_name": "Aihara / Kouichi (D-016 default 'Koichi' would change)"
  },
  "D3_honorifics": {
   "decide": true,
   "recommended": "Keep, romanized and hyphenated: -san, -kun, -chan, -senpai, -sensei; 姉ちゃん -> -nee; お兄ちゃん -> Onii-chan. Honorific follows the name exactly as the Japanese does; no honorific where the Japanese has a bare name.",
   "options": [
    "localize: 'Miss Sakino', 'Mr. Aihara', 'Teacher', 'Big Sis Mao', 'Big Bro'",
    "keep only -chan/-senpai/-sensei (meaningful), drop -san/-kun"
   ],
   "counts": {
    "surname+さん (nine named characters)": 2432,
    "ちゃん": 1906,
    "君": 991,
    "先輩": 797,
    "先生": 314,
    "さん total": 2845
   }
  },
  "D4_megumu_gag": {
   "decide": true,
   "recommended": "Keep the joke: she is 'Megumu' (めぐむ), everyone misreads it 'Megumi' (MEG_DEA:46-67, MEG_KIS_A:37). Translate 'Don't call me Megumi! It's Megumu!'",
   "options": [
    "Megumi (anime/Wikipedia spelling) and drop the gag",
    "Megumu and keep the gag (recommended)"
   ]
  },
  "D5_special_address": {
   "decide": true,
   "recommended": "ご主人様 -> 'Master' (242 uses, 201 lines by Mitsuki; the player and Nana quote it); 摩央姉ちゃん -> 'Mao-nee'; 先輩 as Narumi's address -> 'Senpai'; Eriko says the bare surname; Mao says the bare given name {Nn}; トモちゃん -> 'Tomo-chan'",
   "options": [
    "Master -> 'my lord'/'Mr. {Nm}'; Mao-nee -> 'big sis Mao'; Senpai -> 'Upperclassman'"
   ]
  },
  "D6_sfx_laughs": {
   "decide": true,
   "recommended": "Translate sound effects into English interjections (Hehe/Fufu, Ehehe, Ahaha, Hmm...). No romaji SFX in narration; narration onomatopoeia becomes English (Thud! Crash!). Tilde ～: drop in 80 percent, keep a trailing '~' only for Mao, Nana, Narumi when playful; long vowels stretched ('Sooo') only when it carries emphasis.",
   "options": [
    "keep Japanese SFX romanized (Fufu, Kusu, Doki-doki)",
    "convert to action tags like *giggle*"
   ]
  },
  "D7_punctuation": {
   "decide": true,
   "recommended": "Ellipsis: three ASCII periods '...' for … and '......' for ……; no spaced dots. Stammer: 'S-sorry', one repeat only. Speech in straight double quotes \"...\", thoughts in (parentheses) as the Japanese does (「」 -> \"\", （） -> ()); narration unquoted. Keep ！？ as '?!'; do not stack more than two marks.",
   "options": [
    "use real ellipsis glyph from font rows 11-12 (needs font work)",
    "drop quotes and rely on the speaker plate"
   ]
  },
  "D8_school_game_terms": {
   "decide": true,
   "recommended": "学園祭 'school festival' (labels already); 話題袋 'Topic Bag' (labels already; not 'deck'); 風紀委員 'Discipline Committee'; 校舎裏 'Back Lot' on tabs, 'behind the school' in prose; 花壇 'Garden' on tabs, 'flower bed' only where the flowers matter; Year 1/2/3 and 'Class 2-A'; 先生 -> '-sensei' attached to the name",
   "options": [
    "culture festival",
    "Topic Deck",
    "Public Morals Committee"
   ]
  },
  "D9_plates": {
   "decide": true,
   "recommended": "Plates show surnames as the original (Nana = given name). Measured with tools/font/en_widths.json: Mizusawa 107 px, Satonaka 100, Kirishima 100, Kobayakawa 138, all others <= 86. Current indent is 92 px, so either raise putIndent from 4 to 5 cells (115 px) in one byte, or shorten. Recommend 5 cells and plate 'Michi' for MIC. EX1/EX2 plates: check in game, otherwise 'Girl'/'Boy'.",
   "options": [
    "keep indent 92 and use given names on every plate",
    "abbreviate long surnames"
   ]
  },
  "D10_credits_devnotes": {
   "decide": true,
   "recommended": "Credits (StaffRoll + GUN_PRO): romanize names Family-Given as printed, Hepburn without macrons, translate role words; voice actors use their usual romanization (Koshimizu Ami, Mizuhashi Kaori, Ikezawa Haruna, Hirohashi Ryou, Tanaka Rie, Noto Mamiko, Nogawa Sakura, Nakahara Mai, Kawasumi Ayako, Fukuyama Jun). Dev-memo lines in ERI_PRO/MAO_PRO/YUM_KIS_A (about 35 lines in MAO_PRO, ERI_PRO, YUM_KIS_A, ASU_PRO, NAR_KIS_A, e.g. 'LV2 kiss, all outfits, with or without mob') are not story text: translate literally, low priority.",
   "options": [
    "leave credits in Japanese",
    "ask for staff romanizations from the user"
   ]
  },
  "D11_tone": {
   "decide": true,
   "recommended": "See the tone table in docs/glossary.md section 1."
  }
