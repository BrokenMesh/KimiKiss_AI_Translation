 "policy": {
  "D1_name_order": {
   "decision": "Family-given wherever a full name is printed: 'Sakino Asuka', 'Satonaka Narumi'. Full names are rare (introductions); no extra effort. The seven name plates in labels.tsv already follow this and the name-entry screen is surname first ({Nm} then {Nn}). Spoken address is a bare name (D3).",
   "order": "family-given"
  },
  "D2_romanization": {
   "decision": "Hepburn, ASCII only (the font has no macrons), long vowels written as the kana, as the English anime database (MyAnimeList) spells them: ou/oo, uu, ei. Gives Shijou, Yuumi, Kuryuu, Kouichi; names without a long vowel stay Mao, Eriko, Narumi, Asuka, Nana.",
   "examples": [
    "Shijou",
    "Yuumi",
    "Kuryuu",
    "Kouichi"
   ],
   "macrons": false,
   "label_changes_applied": {
    "233": "Shijou Mitsuki (was Gijo Mizuki, wrong reading)",
    "72": "Kuryuu Megumu (was Kuriu Megumi)",
    "539": "Hoshino Yuumi (was Hoshino Yumi)"
   },
   "default_player_name": "Aihara Kouichi ({Nm} = Aihara, {Nn} = Kouichi; GameParam:166/167, K2_Script:13 = Aihara)"
  },
  "D3_honorifics": {
   "decision": "Omit honorifics, as most anime subtitles do. A name with san/kun/chan/sama is written as the bare name. sensei attached to a name becomes 'Mr. <surname>' or 'Ms. <surname>' by the character's sex. A standalone sensei used as a form of address may stay 'Sensei'. All other special forms follow D5.",
   "honorifics": "omit",
   "rules": [
    "name + san/kun/chan/sama -> bare name ('Sakino', 'Narumi', '{Nm}')",
    "name + senpai -> bare name (standalone senpai: see D5)",
    "name + sensei -> 'Mr. <surname>' / 'Ms. <surname>' by sex ('Ms. Kawada')",
    "standalone sensei as address -> 'Sensei' (allowed); as a common noun -> 'teacher'",
    "never write -san, -kun, -chan, -sama, -senpai, -sensei or -nee after a name"
   ],
   "kept_address_forms": [
    "Master",
    "Senpai",
    "Sensei",
    "Big Bro",
    "big brother"
   ],
   "counts": {
    "surname+san (nine named characters)": 2432,
    "chan": 1906,
    "kun": 991,
    "senpai": 797,
    "sensei": 314,
    "san total": 2845
   }
  },
  "D4_megumu_gag": {
   "decision": "Her name is Kuryuu Megumu. Keep the joke: people misread it as 'Megumi' and she corrects them (MEG_DEA:46-67, MEG_KIS_A:37), e.g. \"It's Megumu, not Megumi!\". Translate, do not localize.",
   "name": "Kuryuu Megumu",
   "misreading": "Megumi"
  },
  "D5_special_address": {
   "decision": "Keep only the address forms that fit English and that anime subtitles commonly keep. Everything else: keep the name part, drop the suffix.",
   "kept_address_forms": {
    "Master": "goshujin-sama, Mitsuki to the player (242 uses; the player and Nana quote it)",
    "Senpai": "Narumi's standalone senpai for the player (name + senpai -> bare name)",
    "Sensei": "standalone sensei used as address; allowed",
    "Big Bro": "Nana's oniichan as a direct address; 'big brother' in prose and narration"
   },
   "mao": "the player's Mao-nee-chan -> 'Mao' ('Mao-nee' is too foreign); a bare nee-chan -> 'sis' only where the line needs it",
   "bare_name": [
    "Eriko and Hiiragi call the player by bare {Nm}",
    "Mao calls the player by bare {Nn}"
   ],
   "nicknames": "keep the name part, drop the suffix: Tomo (Kawada, from Mao), Naru (Narumi, from Nana), Mana (Manami), Rukko (Kaoruko), Eri (Eriko)"
  },
  "D6_sfx_laughs": {
   "decision": "Translate sound effects into English interjections (Hehe, Ahaha, Hmm..., Eep!). Only two romanized signature laughs are kept: 'Ehehe' and 'Fufu'. Narration onomatopoeia becomes English words (Thud, Crash). Tilde: drop by default; keep a trailing '~' only for Mao, Nana and Narumi on playful lines; stretch a vowel ('Sooo') only for emphasis. No action tags like *giggle*.",
   "signature_laughs": [
    "Ehehe",
    "Fufu"
   ],
   "tilde": "mostly dropped; trailing ~ only Mao, Nana, Narumi when playful",
   "table": "docs/glossary.md section 1 (Sound effects and interjections)"
  },
  "D7_punctuation": {
   "decision": "Ellipsis: three ASCII periods '...' for the single ellipsis and '......' for the double; no spaced dots and no ellipsis glyph. Stammer: initial letter + hyphen, one repeat ('S-sorry', 'I-it's'), only where the Japanese repeats the sound; {W n} splits inside words are voice timing, not stammer. Speech in straight double quotes; thoughts in (parentheses) as the Japanese does; narration unquoted. ?! for exclamation-question marks; never more than two marks in a row.",
   "ellipsis": "...",
   "double_ellipsis": "......",
   "stammer": "S-sorry",
   "speech_quotes": "straight double quotes",
   "thought_quotes": "parentheses",
   "max_stacked_marks": 2
  },
